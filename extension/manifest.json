{
    "manifest_version": 3,
    "name": "clickbait",
    "version": "1.0",
    "description": "built by olivia, ryan, and kelso",

    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_popup": "popup.html"
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "all_frames": true,
            "run_at": "document_idle"
        }
    ],

    "web_accessible_resources": [
        {
            "resources": ["img/*", "sounds/*"],
            "matches": ["<all_urls>"]
        }
    ]
}