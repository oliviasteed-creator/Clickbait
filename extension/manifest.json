{
  "manifest_version": 3,
  "name": "Random Click FX",
  "version": "1.0",
  "description": "Built as a team!",

  "permissions": [
    "storage"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup/popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/settings.js", "content/content.js"],
      "css": ["content/content.css"]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["images/*", "sounds/*"],
      "matches": ["<all_urls>"]
    }
  ]
}