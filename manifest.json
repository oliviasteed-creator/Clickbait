{
    "manifest_version": 3,
    "name": "Team Extension",
    "version": "1.0",
    "description": "Built as a team!",

    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "background": {
        "service-worker": "background.js"
    },

    "action": {
        "default_popup": "popup.html" 
    }
}